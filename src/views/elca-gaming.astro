---
import Layout from '../layouts/Layout.astro';
import Gaming from '../components/gaming/Gaming.svelte';
import type { GamingText } from '../gaming/types';
import { getLang } from '../i18n';

const years = ['2026', '2025', '2024'];

const texts: Record<'en' | 'fr', GamingText & { description: string; subtitle: string }> = {
  en: {
    description: 'ELCA board game ranking',
    subtitle: 'Board game ranking',
    loading: 'Loading…',
    leaderboard: 'Leaderboard',
    recent: 'Recent games',
    games: 'Games',
    activePlayers: 'Active players',
    mostWins: 'Most wins',
    gamesN: 'games',
    complexity: 'Complexity',
    players: 'players',
    loadError: 'Could not load the {year} data: {error}',
    win: 'win',
    wins: 'wins',
    tie: 'tie',
    ties: 'ties',
    presentBonus: 'Present 25% bonus',
    winTotal: 'Win total (WT)',
    gamesPlayed: 'Games played',
    ratio: 'Ratio (WT ÷ games)',
    attendanceBonus: 'Attendance bonus',
    total: 'Total',
  },
  fr: {
    description: 'Classement des jeux de société ELCA',
    subtitle: 'Classement des jeux de société',
    loading: 'Chargement…',
    leaderboard: 'Classement',
    recent: 'Parties récentes',
    games: 'Parties',
    activePlayers: 'Joueurs actifs',
    mostWins: 'Max victoires',
    gamesN: 'parties',
    complexity: 'Complexité',
    players: 'joueurs',
    loadError: 'Impossible de charger les données {year} : {error}',
    win: 'victoire',
    wins: 'victoires',
    tie: 'égalité',
    ties: 'égalités',
    presentBonus: 'Bonus présent 25 %',
    winTotal: 'Total victoires (TV)',
    gamesPlayed: 'Parties jouées',
    ratio: 'Ratio (TV ÷ parties)',
    attendanceBonus: 'Bonus de présence',
    total: 'Total',
  },
};
const text = texts[getLang(Astro.url)];
---

<Layout title="🎲 ELCA Gaming" description={text.description} pageSubtitle={text.subtitle} activeNav="hidden">
  <main class="container page">
    <Gaming client:load years={years} t={text} />
  </main>
</Layout>

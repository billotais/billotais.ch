const c = lang === "fr" ? fr : en;
---

<Layout title="CV" description={c.description} activeNav="cv" pageSubtitle={c.subtitle}>
    <main class="container page">
        <p class="cv-links">
            <a href="https://linkedin.com/in/lois-bilat" target="_blank" rel="noopener">
                <Icon name="linkedin-fill" size={16} /> LinkedIn
            </a>
            <a href="https://github.com/Billotais" target="_blank" rel="noopener">
                <Icon name="github-fill" size={16} /> GitHub
            </a>
        </p>

        <section class="cv-section">
            <h2 class="cv-section-title">{c.experience}</h2>
            <div class="timeline">
                {c.jobs.map((job) => (
                    <div class="timeline-entry">
                        <div class="timeline-meta">
                            <div class="timeline-date">{job.date}</div>
                        </div>
                        <span class="timeline-dot" />
                        <div class="timeline-body">
                            <div class="timeline-role">{job.role}</div>
                            <div class="timeline-org">{job.org}</div>
                            <ul class="timeline-bullets">
                                {job.bullets.map((b) => (
                                    <li>
                                        <strong>{b.label}</strong> {b.text}
                                    </li>
                                ))}
                            </ul>
                            <div class="timeline-tags">
                                {job.tags.map((tag) => (
                                    <span class="tag">{tag}</span>
                                ))}
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </section>

        <section class="cv-section">
            <h2 class="cv-section-title">{c.education}</h2>
            {c.edu.map((e) => (
                <div class="edu-entry">
                    <div class="edu-meta">
                        <div class="edu-date">{e.date}</div>
                    </div>
                    <div class="edu-body">
                        <div class="edu-degree">{e.degree}</div>
                        <div class="edu-school">{e.school}</div>
                    </div>
                </div>
            ))}
        </section>

        <section class="cv-section">
            <h2 class="cv-section-title">{c.skills}</h2>
            <div class="skills-two-col">
                {c.skillCards.map((card) => (
                    <div class="skill-card">
                        <div class="skill-card-title">{card.title}</div>
                        <div class="skill-card-items">{card.items}</div>
                    </div>
                ))}
            </div>
        </section>

        <section class="cv-section">
            <h2 class="cv-section-title">{c.certsTitle}</h2>
            <div class="inline-list">
                {c.certs.map((item) => (
                    <div class="inline-item">
                        <span class="inline-item-label">{item.label}</span>
                        {item.html ? <span set:html={item.html} /> : <span>{item.text}</span>}
                    </div>
                ))}
            </div>
        </section>

        <section class="cv-section">
            <h2 class="cv-section-title">{c.languages}</h2>
            <div class="inline-list">
                {c.langs.map((item) => (
                    <div class="inline-item">
                        <span class="inline-item-label">{item.label}</span>
                        <span>{item.text}</span>
                    </div>
                ))}
            </div>
        </section>
    </main>
</Layout>

<style>
    /* Job title under the nav: accent colour, larger and bolder than other pages' subtitles */
    :global(.page-subtitle) {
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--color-accent);
    }

    .cv-links {
        display: flex;
        gap: 10px;
        margin-bottom: 32px;
    }

    .cv-links a {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 14px;
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--color-text);
        border: 1px solid var(--color-border);
        border-radius: 999px;
        transition: border-color 0.15s, color 0.15s;
    }

    .cv-links a:hover {
        border-color: var(--color-accent);
        color: var(--color-accent);
    }
</style>

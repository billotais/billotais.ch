---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import teas from '../../data/teas.json';
import { getLang, ui } from '../../i18n';

const lang = getLang(Astro.url);
const text = {
  en: { description: 'My Tea collection, with brewing notes and personal ratings.', tasted: 'teas tasted', other: 'Other' },
  fr: { description: 'Ma collection de thés, avec notes d\'infusion et mes évaluations.', tasted: 'thés dégustés', other: 'Autres' },
}[lang];

const byType = teas.reduce((acc: Record<string, typeof teas>, tea) => {
  const key = tea.type ?? text.other;
  (acc[key] ??= []).push(tea);
  return acc;
}, {});

const sortedTypes = Object.keys(byType).sort();
---

<Layout
  title={ui[lang].teas}
  description={text.description}
  activeNav="collections"
  pageSubtitle={`${teas.length} ${text.tasted}`}
>
  <main class="container page">
    {sortedTypes.map(type => (
      <section class="cv-section">
        <h2 class="cv-section-title">{type}</h2>
        <div class="tea-list">
          {byType[type].map(tea => (
            <div class="tea-card">
              <div class="tea-card-header">
                <div>
                  <div class="tea-card-name">{tea.name}</div>
                  {tea.brand && <div class="tea-card-brand">{tea.brand}</div>}
                </div>
                {tea.personalRating !== null && (
                  <div class="rating-personal tea-rating">★ {tea.personalRating}<span class="tea-rating-max">/5</span></div>
                )}
              </div>
              <div class="tea-card-details">
                {tea.temperature && <span><Icon name="thermometer" /> {tea.temperature}</span>}
                {tea.infusionTime && <span>⏱ {tea.infusionTime}</span>}
                {tea.purchasePlace && <span><Icon name="pin" /> {tea.purchasePlace}</span>}
              </div>
              {tea.ingredients.length > 0 && (
                <div class="timeline-tags" style="margin-top: 10px;">
                  {tea.ingredients.map((i: string) => <span class="tag">{i}</span>)}
                </div>
              )}
            </div>
          ))}
        </div>
      </section>
    ))}
  </main>
</Layout>

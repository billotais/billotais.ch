---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import oidc from "../config/oidc.json";
import { readFileSync } from "node:fs";

// Protected pages come from the Caddyfile (`handle /path* { import gate <groups> }`), so this list always matches
// what Caddy actually enforces. Each entry is shown only to users whose groups match.
const caddyfile = readFileSync("Caddyfile", "utf8");
const pages = [
    ...caddyfile.matchAll(/(?:#\s*title:\s*(.+)\n\s*)?handle\s+(\S+)\s*\{[^}]*?import\s+gate\s+(?:"([^"]+)"|(\S+))/g),
]
    .filter(([, , path]) => !path.startsWith("/fr/")) // French copies of a page share the English entry
    .map(([, title, path, quoted, bare]) => {
    const base = path.replace(/\/?\*$/, "");
    const name = base.split("/").filter(Boolean).pop() ?? "";
    return { href: `${base}/`, title: title?.trim() ?? name.charAt(0).toUpperCase() + name.slice(1), groups: quoted ?? bare };
});

const themes = [
    { id: "teal", name: "Teal", desc: "The original", from: "#360033", to: "#0b8793", bg: "#ffffff", sec: "#b0308f", ter: "#e08a00" },
    { id: "lagoon", name: "Lagoon", desc: "Cyan to mint", from: "#0e7490", to: "#14b88a", bg: "#ffffff", sec: "#2563eb", ter: "#f59e0b" },
    { id: "aurora", name: "Aurora", desc: "Violet to teal", from: "#5b21b6", to: "#14a8a0", bg: "#ffffff", sec: "#7c3aed", ter: "#ec4899" },
    { id: "ocean", name: "Ocean", desc: "Deep blue to cyan", from: "#1e40af", to: "#0ab4cc", bg: "#ffffff", sec: "#1d4ed8", ter: "#f97316" },
    { id: "coral", name: "Coral", desc: "Teal to coral", from: "#0b8793", to: "#f2694a", bg: "#ffffff", sec: "#0b8793", ter: "#f59e0b" },
    { id: "sunset", name: "Sunset", desc: "Pink to amber", from: "#db2777", to: "#f59e0b", bg: "#ffffff", sec: "#db2777", ter: "#d97706" },
    { id: "berry", name: "Berry", desc: "Magenta to violet", from: "#9d174d", to: "#7c3aed", bg: "#ffffff", sec: "#7c3aed", ter: "#e11d48" },
    { id: "forest", name: "Forest", desc: "Deep to bright green", from: "#14532d", to: "#22a559", bg: "#ffffff", sec: "#0d9488", ter: "#ca8a04" },
    { id: "indigo", name: "Indigo", desc: "Navy to periwinkle", from: "#312e81", to: "#6366f1", bg: "#ffffff", sec: "#0ea5e9", ter: "#ec4899" },
    { id: "citrus", name: "Citrus", desc: "Teal to lime", from: "#0f766e", to: "#84cc16", bg: "#ffffff", sec: "#0f766e", ter: "#ea580c" },
    { id: "graphite", name: "Graphite", desc: "Slate, teal accent", from: "#0f172a", to: "#3b4a5f", bg: "#ffffff", sec: "#6366f1", ter: "#f59e0b" },
    { id: "slate", name: "Slate", desc: "Cool steel", from: "#1e293b", to: "#475569", bg: "#ffffff", sec: "#6366f1", ter: "#f59e0b" },
    { id: "charcoal", name: "Charcoal", desc: "Black to grey, mint", from: "#111111", to: "#3f3f46", bg: "#ffffff", sec: "#06b6d4", ter: "#f59e0b" },
    { id: "midnight", name: "Midnight", desc: "Navy to steel blue", from: "#0b1730", to: "#1f4a78", bg: "#ffffff", sec: "#14b8a6", ter: "#f59e0b" },
    { id: "plum", name: "Plum", desc: "Ink purple", from: "#1f1630", to: "#4c3a6e", bg: "#ffffff", sec: "#ec4899", ter: "#f59e0b" },
    { id: "stone", name: "Stone", desc: "Warm grey, amber", from: "#1c1917", to: "#57534e", bg: "#ffffff", sec: "#0d9488", ter: "#e11d48" },
    { id: "pine", name: "Pine", desc: "Dark green-grey", from: "#0f1f1a", to: "#365a4e", bg: "#ffffff", sec: "#84a800", ter: "#f59e0b" },
];
---

<Layout noLang title="Profile" description="Your account" activeNav="hidden">
    <main class="container auth">
        <div id="state-loading" class="auth-card">
            <p class="auth-muted">Loading…</p>
        </div>

        <div id="state-signed-out" class="auth-card" hidden>
            <span class="auth-icon"><Icon name="lock" size={26} /></span>
            <h1>Sign in</h1>
            <p class="auth-muted">This page is only available to signed-in users.</p>
            <a class="auth-btn" href="/oauth2/start?rd=/profile/">Sign in with SSO</a>
            <p class="auth-muted auth-foot">
                No account yet? <a href={`${oidc.issuer}/signup`}>Create one</a>, then come back and sign in.
            </p>
        </div>

        <div id="state-signed-in" class="auth-card" hidden>
            <span class="auth-icon auth-icon--lg">
                <span id="p-fallback"><Icon name="user" size={34} /></span>
                <img id="p-picture" alt="" hidden />
            </span>
            <h1 id="p-name"></h1>
            <p class="auth-muted" id="p-email"></p>
            <dl class="profile-list" id="p-list"></dl>
            <div id="p-pages" hidden>
                <h2>Your pages</h2>
                <ul id="p-pages-list" class="profile-pages"></ul>
            </div>
            <div id="p-theme">
                <h2>Appearance</h2>
                <div class="theme-grid" role="group" aria-label="Theme">
                    {themes.map((th) => (
                        <button type="button" class="theme-opt" data-theme-set={th.id} aria-pressed="false">
                            <span class="theme-swatch" style={`--from:${th.from};--to:${th.to};--bg:${th.bg};--sec:${th.sec};--ter:${th.ter}`}></span>
                            <span class="theme-name">{th.name}</span>
                            <span class="theme-desc">{th.desc}</span>
                        </button>
                    ))}
                </div>
            </div>
            <a class="auth-btn auth-btn--ghost" href="/oauth2/sign_out?rd=/profile/">Sign out</a>
        </div>

        <noscript><p class="auth-muted">JavaScript is required to sign in.</p></noscript>
    </main>
</Layout>

<style>
    .profile-list {
        display: grid;
        grid-template-columns: max-content 1fr;
        gap: 8px 16px;
        margin: 20px 0;
        padding-top: 18px;
        border-top: 1px solid var(--color-border);
        text-align: left;
        font-size: 0.875rem;
    }
    .profile-list:empty {
        display: none;
    }
    .profile-list dt {
        color: var(--color-text-muted);
    }
    .profile-list dd {
        margin: 0;
        overflow-wrap: anywhere;
    }
    #p-theme {
        margin-bottom: 20px;
        padding-top: 18px;
        border-top: 1px solid var(--color-border);
        text-align: left;
    }
    #p-theme h2 {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-text-muted);
        margin-bottom: 8px;
    }
    .theme-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }
    .theme-opt {
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding: 8px;
        text-align: left;
        font: inherit;
        color: var(--color-text);
        background: var(--color-bg);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);
        cursor: pointer;
    }
    .theme-opt:hover {
        border-color: var(--color-accent);
    }
    .theme-opt[aria-pressed="true"] {
        border-color: var(--color-accent);
        box-shadow: 0 0 0 2px var(--color-accent);
    }
    .theme-swatch {
        height: 34px;
        margin-bottom: 4px;
        border-radius: 4px;
        border: 1px solid rgba(128, 128, 128, 0.3);
        background:
            linear-gradient(90deg, var(--from), var(--to)) top / 100% 45% no-repeat,
            var(--bg);
        position: relative;
    }
    .theme-swatch::after {
        content: "";
        position: absolute;
        left: 6px;
        bottom: 5px;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--sec);
        box-shadow: 12px 0 0 var(--ter);
    }
    .theme-name {
        font-size: 0.85rem;
        font-weight: 600;
    }
    .theme-desc {
        font-size: 0.75rem;
        color: var(--color-text-muted);
    }
    #p-pages {
        margin-bottom: 4px;
        padding-top: 18px;
        border-top: 1px solid var(--color-border);
        text-align: left;
    }
    #p-pages h2 {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-text-muted);
        margin-bottom: 8px;
    }
    .profile-pages {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 4px;
    }
    .profile-pages a {
        display: block;
        padding: 8px 12px;
        border-radius: 8px;
        font-weight: 500;
    }
    .profile-pages a:hover {
        background: var(--color-accent-light);
        text-decoration: none;
    }
</style>

<script define:vars={{ issuer: oidc.issuer, pages }}>
    // The session lives in oauth2-proxy's cookie (see Caddyfile); /oauth2/userinfo answers 200 with the user
    // when signed in and 401 otherwise.
    function show(id) {
        ["state-loading", "state-signed-out", "state-signed-in"].forEach(function (s) {
            document.getElementById(s).hidden = s !== id;
        });
    }

    function render(user) {
        var name = user.preferredUsername || user.user || user.email || "Signed in";
        document.getElementById("p-name").textContent = name;
        document.getElementById("p-email").textContent = user.email || "";
        var rows = [
            ["Groups", Array.isArray(user.groups) ? user.groups.join(", ") : null],
        ];
        var list = document.getElementById("p-list");
        list.textContent = "";
        rows.forEach(function (row) {
            if (!row[1]) return;
            var dt = document.createElement("dt");
            var dd = document.createElement("dd");
            dt.textContent = row[0];
            dd.textContent = row[1];
            list.append(dt, dd);
        });
        // Same rule as the Caddyfile gate: one of the user's groups must fully match the page's group pattern.
        var groups = Array.isArray(user.groups) ? user.groups : [];
        var allowed = pages.filter(function (page) {
            var rule = new RegExp("^(" + page.groups + ")$");
            return groups.some(function (g) {
                return rule.test(g);
            });
        });
        var pagesList = document.getElementById("p-pages-list");
        pagesList.textContent = "";
        allowed.forEach(function (page) {
            var li = document.createElement("li");
            var a = document.createElement("a");
            a.href = page.href;
            a.textContent = page.title;
            li.append(a);
            pagesList.append(li);
        });
        document.getElementById("p-pages").hidden = allowed.length === 0;
        if (/^[0-9a-f]{8}-([0-9a-f]{4}-){3}[0-9a-f]{12}$/i.test(user.user || "")) {
            var img = document.getElementById("p-picture");
            img.addEventListener("load", function () {
                document.getElementById("p-fallback").hidden = true;
            });
            img.addEventListener("error", function () {
                img.hidden = true;
            });
            img.src = issuer + "/api/users/" + user.user + "/profile-picture.png";
            img.hidden = false;
        }
        show("state-signed-in");
    }

    // Theme picker: stored in localStorage, applied via data-theme (see Layout.astro / themes.css)
    var current = document.documentElement.dataset.theme || "teal";
    var opts = document.querySelectorAll("[data-theme-set]");
    function markTheme() {
        opts.forEach(function (b) {
            b.setAttribute("aria-pressed", String(b.dataset.themeSet === current));
        });
    }
    opts.forEach(function (b) {
        b.addEventListener("click", function () {
            current = b.dataset.themeSet;
            if (current === "teal") delete document.documentElement.dataset.theme;
            else document.documentElement.dataset.theme = current;
            try {
                localStorage.setItem("theme", current);
            } catch (e) {}
            markTheme();
        });
    });
    markTheme();

    fetch("/oauth2/userinfo", { headers: { Accept: "application/json" } })
        .then(function (r) {
            if (!r.ok) throw new Error(String(r.status));
            return r.json();
        })
        .then(render)
        .catch(function () {
            show("state-signed-out");
        });
</script>

---
import Layout from "../layouts/Layout.astro";
import oidc from "../config/oidc.json";
import { readFileSync } from "node:fs";

// Protected pages come from the Caddyfile (`handle /path* { import gate <groups> }`), so this list always matches
// what Caddy actually enforces. Each entry is shown only to users whose groups match.
const caddyfile = readFileSync("Caddyfile", "utf8");
const pages = [
    ...caddyfile.matchAll(/(?:#\s*title:\s*(.+)\n\s*)?handle\s+(\S+)\s*\{[^}]*?import\s+gate\s+(?:"([^"]+)"|(\S+))/g),
]
    .filter(([, , path]) => !path.startsWith("/fr/")) // French copies of a page share the English entry
    .map(([, title, path, quoted, bare]) => {
    const base = path.replace(/\/?\*$/, "");
    const name = base.split("/").filter(Boolean).pop() ?? "";
    return { href: `${base}/`, title: title?.trim() ?? name.charAt(0).toUpperCase() + name.slice(1), groups: quoted ?? bare };
});
---

<Layout noLang title="Profile" description="Your account" activeNav="hidden" pageSubtitle="Signed in with SSO">
    <main class="container page">
        <div id="state-loading" class="profile-card">Loading…</div>

        <div id="state-signed-out" class="profile-card" hidden>
            <h2>Sign in</h2>
            <p class="muted">This page is only available to signed-in users.</p>
            <a class="profile-btn" href="/oauth2/start?rd=/profile/">Sign in with SSO</a>
            <p class="muted signup">No account yet? <a href={`${oidc.issuer}/signup`}>Create one</a>, then come back and sign in.</p>
        </div>

        <div id="state-signed-in" class="profile-card" hidden>
            <div class="profile-head">
                <img id="p-picture" class="profile-picture" alt="" hidden />
                <div>
                    <h2 id="p-name"></h2>
                    
                </div>
            </div>
            <dl class="profile-list" id="p-list"></dl>
            <div id="p-pages" hidden>
                <h3>Your pages</h3>
                <ul id="p-pages-list" class="profile-pages"></ul>
            </div>
            <a class="profile-btn profile-btn--ghost" href="/oauth2/sign_out?rd=/profile/">Sign out</a>
        </div>

        <noscript><p class="muted">JavaScript is required to sign in.</p></noscript>
    </main>
</Layout>

<style>
    .profile-card {
        max-width: 480px;
        padding: 24px;
        background: var(--color-bg-subtle);
        border: 1px solid var(--color-border);
        border-radius: 12px;
    }
    .profile-card[hidden] { display: none; }
    h2 { font-size: 1.2rem; margin-bottom: 4px; }
    .muted { color: var(--color-text-muted); font-size: 0.9rem; }
    .profile-head { display: flex; align-items: center; gap: 16px; margin-bottom: 20px; }
    .profile-picture { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; }
    .profile-list { display: grid; grid-template-columns: max-content 1fr; gap: 8px 16px; margin-bottom: 24px; }
    .profile-list dt { color: var(--color-text-muted); font-size: 0.85rem; }
    .profile-list dd { margin: 0; overflow-wrap: anywhere; }
    h3 { font-size: 0.85rem; color: var(--color-text-muted); font-weight: 600; margin-bottom: 8px; }
    #p-pages { margin-bottom: 24px; }
    .profile-pages { list-style: none; padding: 0; margin: 0; display: grid; gap: 4px; }
    .profile-btn {
        display: inline-block;
        margin-top: 16px;
        text-decoration: none;
        padding: 9px 18px;
        border: 1px solid var(--color-accent);
        border-radius: 8px;
        background: var(--color-accent);
        color: #fff;
        font: inherit;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.15s;
    }
    .profile-btn:hover { background: var(--color-accent-hover); color: #fff; }
    .profile-btn--ghost { margin-top: 0; background: none; color: var(--color-accent); }
    .profile-btn--ghost:hover { background: var(--color-accent-light); color: var(--color-accent); }
    .signup { margin-top: 16px; }
</style>

<script define:vars={{ issuer: oidc.issuer, pages }}>
    // The session lives in oauth2-proxy's cookie (see Caddyfile); /oauth2/userinfo answers 200 with the user
    // when signed in and 401 otherwise.
    function show(id) {
        ["state-loading", "state-signed-out", "state-signed-in"].forEach(function (s) {
            document.getElementById(s).hidden = s !== id;
        });
    }

    function render(user) {
        var name = user.preferredUsername || user.user || user.email || "Signed in";
        document.getElementById("p-name").textContent = name;
        var rows = [
            ["Email", user.email],
            ["Groups", Array.isArray(user.groups) ? user.groups.join(", ") : null],
            ["User ID", user.user],
        ];
        var list = document.getElementById("p-list");
        list.textContent = "";
        rows.forEach(function (row) {
            if (!row[1]) return;
            var dt = document.createElement("dt");
            var dd = document.createElement("dd");
            dt.textContent = row[0];
            dd.textContent = row[1];
            list.append(dt, dd);
        });
        // Same rule as the Caddyfile gate: one of the user's groups must fully match the page's group pattern.
        var groups = Array.isArray(user.groups) ? user.groups : [];
        var allowed = pages.filter(function (page) {
            var rule = new RegExp("^(" + page.groups + ")$");
            return groups.some(function (g) {
                return rule.test(g);
            });
        });
        var pagesList = document.getElementById("p-pages-list");
        pagesList.textContent = "";
        allowed.forEach(function (page) {
            var li = document.createElement("li");
            var a = document.createElement("a");
            a.href = page.href;
            a.textContent = page.title;
            li.append(a);
            pagesList.append(li);
        });
        document.getElementById("p-pages").hidden = allowed.length === 0;
        if (/^[0-9a-f]{8}-([0-9a-f]{4}-){3}[0-9a-f]{12}$/i.test(user.user || "")) {
            var img = document.getElementById("p-picture");
            img.addEventListener("error", function () {
                img.hidden = true;
            });
            img.src = issuer + "/api/users/" + user.user + "/profile-picture.png";
            img.hidden = false;
        }
        show("state-signed-in");
    }

    fetch("/oauth2/userinfo", { headers: { Accept: "application/json" } })
        .then(function (r) {
            if (!r.ok) throw new Error(String(r.status));
            return r.json();
        })
        .then(render)
        .catch(function () {
            show("state-signed-out");
        });
</script>

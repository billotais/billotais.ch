---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import oidc from "../config/oidc.json";
---

<Layout noLang title="Sign in" description="Sign in to continue" activeNav="hidden">
    <main class="container auth">
        <div class="auth-card">
            <span class="auth-icon"><Icon name="lock" size={26} /></span>
            <h1>Sign in to continue</h1>
            <p class="auth-muted">This page is only available to signed-in users.</p>
            <a id="login-btn" class="auth-btn" href="/oauth2/start?rd=/profile/">Sign in with SSO</a>
            <p class="auth-muted auth-foot">
                No account yet? <a href={`${oidc.issuer}/signup`}>Create one</a>, then come back here and sign in.
            </p>
        </div>
    </main>
</Layout>

<script>
    // Send the user back to the page they asked for (the Caddy gate passes it as ?rd=). Only local paths.
    var rd = new URLSearchParams(location.search).get("rd");
    if (rd && rd.charAt(0) === "/" && rd.charAt(1) !== "/") {
        (document.getElementById("login-btn") as HTMLAnchorElement).href = "/oauth2/start?rd=" + encodeURIComponent(rd);
    }
</script>

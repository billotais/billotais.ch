---
import "../styles/global.css";
import "../styles/themes.css";
import Icon from "../components/Icon.astro";
import oidc from "../config/oidc.json";
import { getLang, localePath, altPath, ui } from "../i18n";

interface Props {
    title: string;
    description?: string;
    activeNav?: string;
    pageSubtitle?: string;
    navTitle?: string;
    /** Pages with no French version (login, profile…): no language switch, no redirect. */
    noLang?: boolean;
}

const lang = getLang(Astro.url);
const t = ui[lang];
const { title, description = t.description, activeNav, pageSubtitle, navTitle, noLang = false } = Astro.props;
const L = (path: string) => localePath(lang, path);
const collections = [
    { href: "/collections/tv-shows", title: t.tvShows, icon: "tv" },
    { href: "/collections/races", title: t.races, icon: "flag" },
    { href: "/collections/vinyls", title: t.vinyls, icon: "disc" },
    { href: "/collections/board-games", title: t.boardGames, icon: "dices" },
    { href: "/collections/video-games", title: t.videoGames, icon: "gamepad" },
    { href: "/collections/teas", title: t.teas, icon: "tea" },
];
const enPath = lang === "fr" ? altPath(lang, Astro.url.pathname) : Astro.url.pathname;
const frPath = lang === "fr" ? Astro.url.pathname : altPath(lang, Astro.url.pathname);
const site = Astro.site?.origin ?? "";
const fullTitle = title === "Loïs Bilat" ? title : `${title} – Loïs Bilat`;
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:locale" content={lang === "fr" ? "fr_CH" : "en_CH"} />
        {!noLang && <link rel="alternate" hreflang="en" href={site + enPath} />}
        {!noLang && <link rel="alternate" hreflang="fr" href={site + frPath} />}
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{fullTitle}</title>
        <script is:inline>
            try {
                var th = localStorage.getItem("theme");
                if (th) document.documentElement.dataset.theme = th;
            } catch (e) {}
        </script>
        {
            !noLang && lang === "en" && (
                <script is:inline define:vars={{ frPath }}>
                    // Remembered choice: visitors who picked French are sent to the French version of this page
                    try {
                        if (localStorage.getItem("lang") === "fr") location.replace(frPath + location.search + location.hash);
                    } catch (e) {}
                </script>
            )
        }
    </head>
    <body>
        <nav class="nav">
            <div class="container nav-inner">
                <div class="nav-brand" id="nav-brand" data-reveal={activeNav === "home" ? "" : undefined}>
                    <a href={L("/")} class="nav-logo">
                        Loïs Bilat
                    </a>
                    {activeNav !== "home" && pageSubtitle !== undefined && (
                        <span class="nav-crumb">{navTitle ?? title}</span>
                    )}
                </div>

                <ul class="nav-links" id="nav-links">
                    <li>
                        <a
                            href={L("/")}
                            class={`nav-home${activeNav === "home" ? " active" : ""}`}
                            aria-label={t.home}
                            title={t.home}
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5z" />
                                <polyline points="9 21 9 12 15 12 15 21" />
                            </svg>
                        </a>
                    </li>
                    <li>
                        <a href={L("/cv")} class={activeNav === "cv" ? "active" : ""}>
                            {t.cv}
                        </a>
                    </li>
                    <li>
                        <a href={L("/projects")} class={activeNav === "projects" ? "active" : ""}>
                            {t.projects}
                        </a>
                    </li>
                    <li class="nav-dropdown" id="nav-dropdown">
                        <button
                            type="button"
                            class={`nav-drop-toggle${activeNav === "collections" ? " active" : ""}`}
                            id="nav-drop-toggle"
                            aria-haspopup="true"
                            aria-expanded="false"
                        >
                            {t.collections}{" "}
                            <span class="nav-caret" aria-hidden="true">
                                ▾
                            </span>
                        </button>
                        <ul class="nav-submenu">
                            {collections.map((c) => (
                                <li>
                                    <a
                                        href={L(c.href)}
                                        class={Astro.url.pathname.replace(/\/$/, "") === L(c.href) ? "active" : ""}
                                    >
                                        <Icon name={c.icon} size={16} />
                                        {c.title}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </li>
                    <li>
                        <a href={L("/blog")} class={activeNav === "blog" ? "active" : ""}>
                            {t.blog}
                        </a>
                    </li>
                </ul>

                <div class="nav-actions">
                    <a
                        href="/profile/"
                        id="profile-link"
                        class="nav-icon"
                        aria-label={t.profile}
                        title={t.profile}
                        data-avatar-base={oidc.issuer}
                    >
                        <span id="profile-icon">
                            <Icon name="user" size={20} />
                        </span>
                        <img id="profile-avatar" class="nav-avatar" alt="" hidden />
                    </a>
                    <button id="nav-hamburger" class="nav-hamburger" aria-label={t.menu} aria-expanded="false">
                        <svg
                            id="hamburger-icon-open"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                        >
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <line x1="3" y1="12" x2="21" y2="12"></line>
                            <line x1="3" y1="18" x2="21" y2="18"></line>
                        </svg>
                        <svg
                            id="hamburger-icon-close"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            style="display:none"
                        >
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>
        </nav>

        {pageSubtitle !== undefined && (
            <div class="page-band">
                <div class="container">
                    <h1 class={`page-title${navTitle ? "" : " page-title--hidden"}`}>{title}</h1>
                    {pageSubtitle && <p class="page-subtitle">{pageSubtitle}</p>}
                </div>
            </div>
        )}

        <slot />

        <footer class="footer">
            <div class="container">
                <span class="footer-copy">© {new Date().getFullYear()} Loïs Bilat</span>
                {
                    !noLang && (
                        <span class="footer-lang" role="group" aria-label={t.language}>
                            <a
                                href={enPath}
                                data-lang="en"
                                hreflang="en"
                                lang="en"
                                aria-current={lang === "en" ? "true" : undefined}
                            >
                                EN
                            </a>
                            <a
                                href={frPath}
                                data-lang="fr"
                                hreflang="fr"
                                lang="fr"
                                aria-current={lang === "fr" ? "true" : undefined}
                            >
                                FR
                            </a>
                        </span>
                    )
                }
                <span class="footer-links">
                    <a
                        href="https://linkedin.com/in/lois-bilat"
                        target="_blank"
                        rel="noopener"
                        aria-label="LinkedIn"
                        title="LinkedIn"
                    >
                        <Icon name="linkedin-fill" size={18} />
                    </a>
                    <a
                        href="https://github.com/Billotais"
                        target="_blank"
                        rel="noopener"
                        aria-label="GitHub"
                        title="GitHub"
                    >
                        <Icon name="github-fill" size={18} />
                    </a>
                </span>
            </div>
        </footer>

        <script is:inline define:vars={{ lang, noLang }}>
            (function () {
                // Remember the language: a click on the switch wins over the saved one, and a French page saves itself
                if (!noLang) {
                    try {
                        if (lang === "fr") localStorage.setItem("lang", "fr");
                    } catch (e) {}
                    document.querySelectorAll(".footer-lang a").forEach(function (a) {
                        a.addEventListener("click", function () {
                            try {
                                localStorage.setItem("lang", a.dataset.lang);
                            } catch (e) {}
                        });
                    });
                }

                // Profile picture from Pocket ID when signed in (the user id oauth2-proxy reports is the Pocket ID
                // user id); falls back to the plain icon. The URL is cached to avoid a flash on each page.
                var profileLink = document.getElementById("profile-link");
                var avatar = document.getElementById("profile-avatar");
                var AVATAR_KEY = "avatar_url";
                function setAvatar(url) {
                    document.getElementById("profile-icon").hidden = !!url;
                    avatar.hidden = !url;
                    if (url) avatar.src = url;
                }
                avatar.addEventListener("error", function () {
                    setAvatar(null);
                });
                try {
                    setAvatar(localStorage.getItem(AVATAR_KEY));
                } catch (e) {}
                fetch("/oauth2/userinfo", { headers: { Accept: "application/json" } })
                    .then(function (r) {
                        if (!r.ok) throw new Error(String(r.status));
                        return r.json();
                    })
                    .then(function (user) {
                        var isId = /^[0-9a-f]{8}-([0-9a-f]{4}-){3}[0-9a-f]{12}$/i.test(user.user || "");
                        var url = isId
                            ? profileLink.dataset.avatarBase + "/api/users/" + user.user + "/profile-picture.png"
                            : null;
                        setAvatar(url);
                        try {
                            if (url) localStorage.setItem(AVATAR_KEY, url);
                            else localStorage.removeItem(AVATAR_KEY);
                        } catch (e) {}
                    })
                    .catch(function () {
                        setAvatar(null);
                        try {
                            localStorage.removeItem(AVATAR_KEY);
                        } catch (e) {}
                    });

                // Home: the name in the nav fades in once the big one in the hero has scrolled away
                var brand = document.getElementById("nav-brand");
                var heading = document.getElementById("hero-heading");
                if (brand && heading && "IntersectionObserver" in window) {
                    brand.setAttribute("data-reveal-ready", "");
                    new IntersectionObserver(
                        function (entries) {
                            brand.toggleAttribute("data-shown", !entries[0].isIntersecting);
                        },
                        { rootMargin: "-60px 0px 0px 0px" },
                    ).observe(heading);
                }

                var dropdown = document.getElementById("nav-dropdown");
                var dropToggle = document.getElementById("nav-drop-toggle");
                function setDrop(open) {
                    dropdown.classList.toggle("open", open);
                    dropToggle.setAttribute("aria-expanded", open ? "true" : "false");
                }
                dropToggle.addEventListener("click", function () {
                    setDrop(!dropdown.classList.contains("open"));
                });
                document.addEventListener("click", function (e) {
                    if (!dropdown.contains(e.target)) setDrop(false);
                });
                document.addEventListener("keydown", function (e) {
                    if (e.key === "Escape") setDrop(false);
                });

                var hamburger = document.getElementById("nav-hamburger");
                var navLinks = document.getElementById("nav-links");
                hamburger.addEventListener("click", function () {
                    var open = navLinks.classList.toggle("nav-open");
                    hamburger.setAttribute("aria-expanded", open ? "true" : "false");
                    document.getElementById("hamburger-icon-open").style.display = open ? "none" : "";
                    document.getElementById("hamburger-icon-close").style.display = open ? "" : "none";
                });
                navLinks.querySelectorAll("a").forEach(function (a) {
                    a.addEventListener("click", function () {
                        navLinks.classList.remove("nav-open");
                        hamburger.setAttribute("aria-expanded", "false");
                        document.getElementById("hamburger-icon-open").style.display = "";
                        document.getElementById("hamburger-icon-close").style.display = "none";
                    });
                });
            })();
        </script>
    </body>
</html>

---
import { nextRace, fmtDate, fmtKm } from '../lib/races';
import Icon from './Icon.astro';
import { getLang } from '../i18n';

const lang = getLang(Astro.url);
const text = {
  en: { days: 'days', today: 'today!', day1: 'day to go', days2: 'days to go', next: 'Next race' },
  fr: { days: 'jours', today: "aujourd'hui !", day1: 'jour restant', days2: 'jours restants', next: 'Prochaine course' },
}[lang];
---

{nextRace && (
  <div
    class="countdown"
    data-date={nextRace.date}
    data-days={text.days}
    data-today={text.today}
    data-day1={text.day1}
    data-days2={text.days2}
  >
    <div class="countdown-days">
      <span class="countdown-num" data-days>–</span>
      <span class="countdown-unit" data-unit>{text.days}</span>
    </div>
    <div class="countdown-info">
      <div class="countdown-label">{text.next}</div>
      <div class="countdown-name">{nextRace.name}</div>
      <div class="countdown-meta">
        <span class="cm"><Icon name="calendar" /> {fmtDate(nextRace.date, true, lang)}</span><span class="cm"><Icon name="ruler" /> {fmtKm(nextRace.distance)}</span>{nextRace.goalTime && <span class="cm"><Icon name="target" /> {nextRace.goalTime}</span>}
      </div>
    </div>
  </div>
)}

<script>
  document.querySelectorAll<HTMLElement>('.countdown').forEach((el) => {
    const target = new Date(el.dataset.date + 'T00:00:00');
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const days = Math.round((target.getTime() - today.getTime()) / 86400000);
    const num = el.querySelector('[data-days]')!;
    const unit = el.querySelector('[data-unit]')!;
    if (days <= 0) {
      num.textContent = '0';
      unit.textContent = days === 0 ? el.dataset.today! : el.dataset.days!;
    } else {
      num.textContent = String(days);
      unit.textContent = days === 1 ? el.dataset.day1! : el.dataset.days2!;
    }
  });
</script>

<style>
  .cm { display: inline-flex; align-items: center; gap: 4px; }
  .cm + .cm::before { content: '·'; margin: 0 4px 0 8px; } /* + the 4px gap after it = 8px each side */
  .countdown {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.25rem 1.5rem;
    margin-bottom: 2rem;
    border-radius: 14px;
    color: #fff;
    background: linear-gradient(135deg, var(--color-hero-from), var(--color-hero-to));
  }
  .countdown-days { text-align: center; min-width: 5.5rem; }
  .countdown-num { display: block; font-size: 3rem; font-weight: 800; line-height: 1; }
  .countdown-unit { font-size: 0.75rem; opacity: 0.85; text-transform: uppercase; letter-spacing: 0.05em; }
  .countdown-label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; opacity: 0.8; }
  .countdown-name { font-size: 1.35rem; font-weight: 700; margin: 0.15rem 0; }
  /* Flex row, not inline baselines: each .cm starts with an icon or the "·", whose baselines differ */
  .countdown-meta { display: flex; flex-wrap: wrap; align-items: center; row-gap: 2px; font-size: 0.875rem; opacity: 0.9; }
  @media (max-width: 560px) {
    .countdown { flex-direction: column; text-align: center; gap: 0.75rem; }
  }
</style>

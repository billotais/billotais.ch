};

const { name, size = "1em" } = Astro.props;
if (!(name in paths)) throw new Error(`Unknown icon "${name}" (add it to the paths map in Icon.astro)`);
---

<svg
    class="icon"
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    set:html={paths[name as keyof typeof paths]}
/>
